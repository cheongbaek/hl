<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>broon</name>
  <version>0.1.0</version>
  <description>헤네스 브룬 T870 하드웨어 — 아두이노(UNO R4 Minima) 브리지, GPS 노드(전방 · 후방), GPS 배치 설정, 장치 점검</description>
  <maintainer email="cheongbaek@users.noreply.github.com">cheongbaek</maintainer>
  <license>Proprietary</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <exec_depend>python3-serial</exec_depend>
  <exec_depend>python3-tk</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

// =====================================================================================
// analog_input.ino ― 가변저항(아날로그 입력) 값 확인 (Arduino UNO R4 Minima)
// =====================================================================================
// cheongbaek/mad-code 의 dc_0701_potential.ino (조향 피드백 포텐셔미터 모니터링)를 옮겼다 (2026-11-12).
// 고친 것 : 문구를 모두 뺐다 · delay(100) 을 없앴다 · 핀 A2 → A0 · 최솟값/최댓값 추적을 뺐다.
// ★컴파일도 업로드도 해 보지 않았다 — 미검증★
//
// ── 출력 (아두이노 → PC) ───────────────────────────────────────────────────────────
//   loop 마다 한 줄 : 현재 analogRead 값 그대로 (거르지도 환산하지도 않는다). 숫자만 — 시리얼 플로터에 그대로 뜬다.
//   ★시간 딜레이 없이★ 읽는 대로 낸다. 실제 줄 수는 USB 로 받아 가는 속도에 달렸다.
//
// ── 값의 범위 ─────────────────────────────────────────────────────────────────────
//   ADC_BITS = 10 이면 0 ~ 1023 (Mega 의 analogRead 와 같은 눈금 — legacy_white.ino 의 ADC 52 ~ 935 와 바로 비교된다).
//   R4 Minima 는 12 · 14 비트도 된다 (0 ~ 4095 · 0 ~ 16383). 기준 전압은 5 V 그대로다.

// ===================== 파라미터 =====================
const uint8_t POT_PIN  = A0;   // ★확인할 핀★ — UNO R4 Minima 는 A0 ~ A5
const int     ADC_BITS = 10;   // 10 · 12 · 14

#define SERIAL_BAUD 115200     // R4 Minima 의 Serial 은 USB 라 실제로는 속도와 무관하다. 모니터 · 플로터도 115200 으로

void setup() {
  Serial.begin(SERIAL_BAUD);
  analogReadResolution(ADC_BITS);
}

void loop() {
  Serial.println(analogRead(POT_PIN));
}
